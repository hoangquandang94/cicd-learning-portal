<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Học & Thực Hành CI/CD + Docker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-primary">DEVOPS</span>
                    <span>CI/CD & Docker Portal (.NET MVC)</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Lộ trình 6 Bước CI/CD</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="DockerGuide">Cẩm nang Docker cho .NET</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info" href="/health" target="_blank">Kiểm tra /health (JSON)</a>
                        </li>
                    </ul>
                    <span class="navbar-text text-light small">
                        GitHub Actions + Docker Production
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small">
            <div>
                &copy; 2026 - <strong>Cổng Tài Liệu & Thực Hành CI/CD Chuyên Sâu</strong> (Từ Bonobo/Jenkins/IIS tới GitHub Actions & Docker)
            </div>
            <div>
                <a href="/health" target="_blank" class="text-decoration-none">Health Check Endpoint</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
